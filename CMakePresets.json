{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": true }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "HIPPOCAFE_WARNINGS_AS_ERRORS": true
      }
    },
    {
      "name": "sanitized",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "HIPPOCAFE_ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "fuzz",
      "inherits": "sanitized",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "BUILD_TESTING": false,
        "HIPPOCAFE_BUILD_EXAMPLES": false,
        "HIPPOCAFE_BUILD_FUZZERS": true
      }
    },
    {
      "name": "release-benchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "HIPPOCAFE_BUILD_BENCHMARKS": true
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "sanitized", "configurePreset": "sanitized" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "release-benchmarks", "configurePreset": "release-benchmarks" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "sanitized", "configurePreset": "sanitized", "output": { "outputOnFailure": true } }
  ]
}
