foreach(manifest IN ITEMS SHA256SUMS LOCAL_SHA256SUMS)
  file(STRINGS "${FIXTURE_DIR}/${manifest}" entries)
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^([a-f0-9]+)  (.+)$")
      message(FATAL_ERROR "Invalid checksum entry in ${manifest}")
    endif()
    set(expected "${CMAKE_MATCH_1}")
    set(relative_path "${CMAKE_MATCH_2}")
    set(path "${FIXTURE_DIR}/${relative_path}")
    if(manifest STREQUAL "LOCAL_SHA256SUMS" AND NOT EXISTS "${path}")
      continue()
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Fixture checksum mismatch for ${relative_path}")
    endif()
  endforeach()
endforeach()
