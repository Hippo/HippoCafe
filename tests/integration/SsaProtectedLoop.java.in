public final class @fixture@ {
    private static int step(int iteration, int site, int failure, StringBuilder events) {
        events.append(site);
        if (iteration * 2 + site == failure) {
            if (site == 1) {
                throw new ArithmeticException();
            }
            throw new IllegalStateException();
        }
        return iteration + site * 7;
    }

    public static int run(int trips, int failure, StringBuilder events) {
        int value = 7;
        for (int i = 0; i < trips; ++i) {
            try {
                int delta = step(i, @first_site@, failure, events);
                if ((i & 1) == 0) {
                    value = value * 3 + delta;
                } else {
                    value -= delta;
                }
                value += step(i, @second_site@, failure, events);
            } catch (ArithmeticException ex) {
                events.append('A');
                value = -value;
                @arithmetic_exit@;
            } catch (RuntimeException ex) {
                events.append('R');
                value -= 23;
                @runtime_exit@;
            }
            events.append('+');
        }
        return value;
    }
}
