# Run from the repository root: doxygen Doxyfile
PROJECT_NAME           = HippoCafe
PROJECT_BRIEF          = "C++23 JVM class-file and archive manipulation"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include src docs README.md tests/fixtures/README.md examples
FILE_PATTERNS          = *.hpp *.cpp *.md *.dox
RECURSIVE              = YES
# Document the mnemonic functions produced by the shared opcode table.
INCLUDE_PATH           = include
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXCLUDE_SYMBOLS        = HIPPOCAFE_INSN_* HIPPOCAFE_EXPAND_MNEMONICS
EXPAND_AS_DEFINED      = HIPPOCAFE_EXPAND_MNEMONICS HIPPOCAFE_INSN_SIMPLE HIPPOCAFE_INSN_LOCAL HIPPOCAFE_INSN_BRANCH HIPPOCAFE_INSN_FIELD HIPPOCAFE_INSN_TYPE
EXCLUDE                = examples/class_file_io.hpp
EXAMPLE_PATH           = examples
EXAMPLE_RECURSIVE      = YES
USE_MDFILE_AS_MAINPAGE  = docs/README.md
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
INTERNAL_DOCS          = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
HAVE_DOT               = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
